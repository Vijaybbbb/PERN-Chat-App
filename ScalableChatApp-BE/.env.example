# Copy this file to .env and replace both values with independently generated
# random secrets. Do not reuse the old JWT secret.
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters_long

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chatapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Optional AI features. Use an IAM role in production when possible.
BEDROCK_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
