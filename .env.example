# Docker Compose reads these values from the repository root.
# Generate two different random values; never reuse the old JWT secret.
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters_long

# Observability
LOG_LEVEL=info
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_grafana_password

# Optional Amazon Bedrock / Claude features
BEDROCK_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
